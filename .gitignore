# ==============================================================================
# Git Ignore Configuration
# Project: HR & Attendance Management System
# ==============================================================================

# 1. Dependencies
node_modules/
backend/node_modules/
backend_failed/
.pnp
.pnp.js
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# 2. Production & Build Outputs
.next/
out/
build/
dist/
backend/dist/

# 3. TypeScript Build Cache & Auto-generated Files
*.tsbuildinfo
backend/*.tsbuildinfo
next-env.d.ts

# 4. Testing & Code Coverage
coverage/
backend/coverage/

# 5. Environment Variables & Credentials (CRITICAL: Never commit database passwords or JWT secret)
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example

# 6. User Uploads & Media (CRITICAL: Never commit employee attendance selfies, receipts, avatars)
uploads/
backend/uploads/
**/uploads/*

# 7. Database Backups & Dumps
backup/
backups/
*.sql
*.dump
*.bak
*.tar.gz

# 8. Scratch & Temporary Testing Workspace
scratch/

# 9. Logs & Debugging
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# 10. OS & Editor Artifacts
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
.vscode/
.idea/
*.swp
*.swo

# 11. Deployment Platforms
.vercel/
.turbo/
