# ==============================================================================
# HR & ATTENDANCE MANAGEMENT SYSTEM — ENVIRONMENT TEMPLATE
# ==============================================================================

# PostgreSQL Database Connection URL (Neon Cloud / Local)
# DATABASE_URL: Connection pooled endpoint (Neon: ...-pooler...neon.tech/neondb?sslmode=require)
DATABASE_URL="postgresql://username:password@localhost:5432/hr_attendance_db?schema=public"

# DIRECT_URL: Direct non-pooled connection for Prisma migrations (Neon: ...neon.tech/neondb?sslmode=require)
DIRECT_URL="postgresql://username:password@localhost:5432/hr_attendance_db?schema=public"

# Application Environment (development | production)
NODE_ENV="development"

# Server Ports
PORT="3000"

# Frontend Web Application URL (CORS allowed origin)
FRONTEND_URL="http://localhost:3000"

# Backend API URL (used by Next.js BFF proxy routes)
BACKEND_API_URL="http://localhost:5001/api"

# JWT Authentication
JWT_SECRET="your-jwt-secret-key-change-in-production-min-32-chars"
JWT_EXPIRES_IN="1d"
