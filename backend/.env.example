# PostgreSQL Database Connection URL (Neon Cloud / Local)
# DATABASE_URL: Connection pooled endpoint (Neon: ...-pooler...neon.tech/neondb?sslmode=require)
DATABASE_URL="postgresql://username:password@localhost:5432/hr_attendance_db?schema=public"

# DIRECT_URL: Direct non-pooled connection for Prisma migrations (Neon: ...neon.tech/neondb?sslmode=require)
DIRECT_URL="postgresql://username:password@localhost:5432/hr_attendance_db?schema=public"

# Application Environment
NODE_ENV="development"
PORT="5001"
FRONTEND_URL="http://localhost:3000"

# JWT Authentication
JWT_SECRET="your-jwt-secret-key-change-in-production"
JWT_EXPIRES_IN="1d"

# ==============================================================================
# CLOUD STORAGE CONFIGURATION (Optional - persistent cloud upload)
# When configured, photos will upload directly to Cloud Storage.
# If omitted, system defaults to persistent Data URI storage in Neon PostgreSQL.
# ==============================================================================

# Option A: Supabase Storage
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_KEY="your-supabase-service-role-or-anon-key"
SUPABASE_STORAGE_BUCKET="attendance-photos"

# Option B: Cloudinary
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
# OR use full connection string:
# CLOUDINARY_URL="cloudinary://api_key:api_secret@cloud_name"

